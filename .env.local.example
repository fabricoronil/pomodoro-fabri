# Copiá este archivo como .env.local y pegá tus claves de Supabase
# (Supabase -> tu proyecto -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Clave VAPID PÚBLICA, para los avisos push con la web cerrada.
# Se genera con:  node scripts/vapid.mjs
# La privada NO va acá: va en los secretos de Supabase (ver README).
# Si la dejás vacía, la app funciona igual, pero sin avisos con la web cerrada.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
